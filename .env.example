# Copy to .env.local and fill in. .env*.local is already gitignored.
#
# The contact form (/api/contact) needs all three of these. Without them the
# route returns a clear "not configured" message rather than silently dropping
# a lead — check your server logs if submissions stop arriving.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives project briefs and newsletter signups.
CONTACT_TO_EMAIL=hello@halveron.com

# Verified sender on your Resend domain. Must be a domain you've verified in
# Resend, not a free mailbox — e.g. "Halveron <website@halveron.com>".
CONTACT_FROM_EMAIL=
